<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>PR_GEELY_FR</name>
    <description>Conversion du Data Flow SSIS &quot;BYD&quot; (package PR_GEELY_FR.dtsx).
Source Excel BYD.xls -&gt; conversion/typage -&gt; constantes + prix formate -&gt; byd.csv (delimite ;).</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>SOURCE_XLS</name>
        <default_value>C:\fichiers\ACKNOW\PR\GVF\Source\BYD.xls</default_value>
        <description>Fichier Excel source</description>
      </parameter>
      <parameter>
        <name>DEST_CSV_DIR</name>
        <default_value>\\10.10.10.8\SGDM\ICAR\BYD\PR\Acknow\France</default_value>
        <description>Repertoire du CSV de sortie</description>
      </parameter>
    </parameters>
    <log/>
    <maxdate>
      <connection/>
      <table/>
      <field/>
      <offset>0.0</offset>
      <maxdiff>0.0</maxdiff>
    </maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capture_delay>1000</step_performance_capture_delay>
    <step_performance_capture_size_limit>100</step_performance_capture_size_limit>
    <dependencies/>
    <partitionschemas/>
    <slaveservers/>
    <clusterschemas/>
    <created_user>-</created_user>
    <created_date>2026/09/14 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/14 00:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Converti depuis SSIS PR_GEELY_FR.dtsx (Data Flow "BYD").
FOURNISSEUR (Excel) n'est pas ecrit en sortie (comme dans le package d'origine).</note>
      <xloc>40</xloc>
      <yloc>20</yloc>
      <width>360</width>
      <heigth>70</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>9</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <connection/>
  <order>
    <hop>
      <from>Source BYD</from>
      <to>Conversion &amp; typage</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Conversion &amp; typage</from>
      <to>Constantes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Constantes</from>
      <to>PX_ACHAT_UNITAIRE</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>PX_ACHAT_UNITAIRE</from>
      <to>byd.csv</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Source BYD</name>
    <type>ExcelInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <header>Y</header>
    <noempty>Y</noempty>
    <stoponempty>N</stoponempty>
    <filefield/>
    <sheetfield/>
    <sheetrowsfield/>
    <rownumfield/>
    <sheetfield_len>0</sheetfield_len>
    <filefield_len>0</filefield_len>
    <limit>0</limit>
    <encoding/>
    <add_to_result_filenames>Y</add_to_result_filenames>
    <accept_filenames>N</accept_filenames>
    <accept_field/>
    <accept_stepname/>
    <file>
      <name>${SOURCE_XLS}</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>FOURNISSEUR</name>
        <type>Number</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>date</name>
        <type>Number</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>Référence</name>
        <type>String</type>
        <length>255</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>quantité</name>
        <type>Number</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>montant unitaire</name>
        <type>Number</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>FACTURE</name>
        <type>String</type>
        <length>255</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>COMMANDE</name>
        <type>Number</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
        <format/>
        <currency/>
        <decimal/>
        <group/>
      </field>
    </fields>
    <sheets>
      <sheet>
        <name>Feuil1</name>
        <startrow>0</startrow>
        <startcol>0</startcol>
      </sheet>
    </sheets>
    <strict_types>N</strict_types>
    <error_ignored>N</error_ignored>
    <error_line_skipped>N</error_line_skipped>
    <bad_line_files_destination_directory/>
    <bad_line_files_extension>warning</bad_line_files_extension>
    <error_line_files_destination_directory/>
    <error_line_files_extension>error</error_line_files_extension>
    <line_number_files_destination_directory/>
    <line_number_files_extension>line</line_number_files_extension>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <spreadsheet_type>JXL</spreadsheet_type>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>176</xloc>
      <yloc>144</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Conversion &amp; typage</name>
    <type>SelectValues</type>
    <description>Renomme les colonnes Excel vers les noms de sortie et fixe les types (equiv. "Conversion de donnees 1").</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>FACTURE</name>
        <rename>NUMERO_BL</rename>
      </field>
      <field>
        <name>date</name>
        <rename>DATE_BL</rename>
      </field>
      <field>
        <name>Référence</name>
        <rename>REFERENCE_LIVREE</rename>
      </field>
      <field>
        <name>quantité</name>
        <rename>QTE_LIVREE</rename>
      </field>
      <field>
        <name>montant unitaire</name>
        <rename>montant_unitaire</rename>
      </field>
      <field>
        <name>COMMANDE</name>
        <rename>NUM_COMMANDE</rename>
      </field>
      <select_unspecified>N</select_unspecified>
      <meta>
        <field>
          <name>NUMERO_BL</name>
          <rename>NUMERO_BL</rename>
          <type>Integer</type>
          <length>-2</length>
          <precision>-2</precision>
          <conversion_mask>#</conversion_mask>
          <date_format_lenient>false</date_format_lenient>
          <date_format_locale/>
          <date_format_timezone/>
          <lenient_string_to_number>false</lenient_string_to_number>
          <encoding/>
          <decimal_symbol/>
          <grouping_symbol/>
          <currency_symbol/>
          <storage_type/>
        </field>
        <field>
          <name>DATE_BL</name>
          <rename>DATE_BL</rename>
          <type>String</type>
          <length>8</length>
          <precision>-2</precision>
          <conversion_mask/>
          <date_format_lenient>false</date_format_lenient>
          <date_format_locale/>
          <date_format_timezone/>
          <lenient_string_to_number>false</lenient_string_to_number>
          <encoding/>
          <decimal_symbol/>
          <grouping_symbol/>
          <currency_symbol/>
          <storage_type/>
        </field>
        <field>
          <name>QTE_LIVREE</name>
          <rename>QTE_LIVREE</rename>
          <type>Integer</type>
          <length>-2</length>
          <precision>-2</precision>
          <conversion_mask>#</conversion_mask>
          <date_format_lenient>false</date_format_lenient>
          <date_format_locale/>
          <date_format_timezone/>
          <lenient_string_to_number>false</lenient_string_to_number>
          <encoding/>
          <decimal_symbol/>
          <grouping_symbol/>
          <currency_symbol/>
          <storage_type/>
        </field>
        <field>
          <name>NUM_COMMANDE</name>
          <rename>NUM_COMMANDE</rename>
          <type>Integer</type>
          <length>-2</length>
          <precision>-2</precision>
          <conversion_mask>#</conversion_mask>
          <date_format_lenient>false</date_format_lenient>
          <date_format_locale/>
          <date_format_timezone/>
          <lenient_string_to_number>false</lenient_string_to_number>
          <encoding/>
          <decimal_symbol/>
          <grouping_symbol/>
          <currency_symbol/>
          <storage_type/>
        </field>
      </meta>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>384</xloc>
      <yloc>144</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Constantes</name>
    <type>Constant</type>
    <description>equiv. "Colonne derivee 2" : DEVISE="EUR", TYPE_COMMANDE="A".</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>TYPE_COMMANDE</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>A</nullif>
        <length>1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>DEVISE</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>EUR</nullif>
        <length>3</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>560</xloc>
      <yloc>144</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>PX_ACHAT_UNITAIRE</name>
    <type>Formula</type>
    <description>equiv. SSIS : REPLACE((DT_WSTR,9)((DT_NUMERIC,7,2)(DT_DECIMAL,2) montant unitaire),",",".")</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <formula>
        <field_name>PX_ACHAT_UNITAIRE</field_name>
        <formula_string>SUBSTITUTE(FIXED([montant_unitaire];2;TRUE());",";".")</formula_string>
        <value_type>String</value_type>
        <value_length>9</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
      </formula>
    </formula>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>720</xloc>
      <yloc>144</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>byd.csv</name>
    <type>TextFileOutput</type>
    <description>equiv. destination fichier plat "BYD" (byd.csv, delimite ;, sans qualificateur, CP1252).</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <separator>;</separator>
    <enclosure/>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>Y</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>CRLF</format>
    <compression>None</compression>
    <encoding>Windows-1252</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${DEST_CSV_DIR}/byd</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>csv</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery>0</splitevery>
    </file>
    <fields>
      <field>
        <name>NUMERO_BL</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>0</precision>
      </field>
      <field>
        <name>DATE_BL</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>8</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>TYPE_COMMANDE</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>REFERENCE_LIVREE</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>22</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>QTE_LIVREE</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>0</precision>
      </field>
      <field>
        <name>PX_ACHAT_UNITAIRE</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>9</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>DEVISE</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>3</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>NUM_COMMANDE</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>0</precision>
      </field>
    </fields>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>896</xloc>
      <yloc>144</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling/>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
</transformation>
