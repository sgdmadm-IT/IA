    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <formula>
      <formula>
        <field_name>TYPE_COMMANDE</field_name>
        <formula_string>"A"</formula_string>
        <value_type>String</value_type>
        <value_length>1</value_length>
        <value_precision>-1</value_precision>
        <replace_field />
      </formula>
      <formula>
        <field_name>CMDE USINE ICAR</field_name>
        <formula_string>LEFT(TRIM(BUYER);3) + RIGHT(TRIM([CMDE ICAR]);7)</formula_string>
        <value_type>String</value_type>
        <value_length>10</value_length>
        <value_precision>-1</value_precision>
        <replace_field />
      </formula>
      <formula>
        <field_name>NUMERO BL</field_name>
        <formula_string>LEFT(TRIM(BUYER);3) + RIGHT(TRIM([CMDE ICAR]);7)</formula_string>
        <value_type>String</value_type>
        <value_length>10</value_length>
        <value_precision>-1</value_precision>
        <replace_field />
      </formula>
    </formula>
